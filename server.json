{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.christian140903-sudo/behaviorlock",
  "description": "Deterministic compatibility gates for recorded observable AI-agent behavior.",
  "repository": {
    "url": "https://github.com/christian140903-sudo/behaviorlock",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "behaviorlock",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "runtimeArguments": ["-y"],
      "packageArguments": ["serve"],
      "environmentVariables": [
        {
          "name": "BEHAVIORLOCK_CONTRACT",
          "description": "Optional default path to behaviorlock.json.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
