{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/christian140903-sudo/behaviorlock/main/behaviorlock.schema.json",
  "title": "Behaviorlock Contract",
  "description": "Deterministic compatibility contracts for observable AI-agent behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "scenarios"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "repository": { "type": "string", "format": "uri" }
      }
    },
    "scenarios": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/scenario" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "jsonValue": {
      "oneOf": [
        { "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "matcher": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "exists" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": { "op": { "const": "equals" }, "value": { "$ref": "#/$defs/jsonValue" } } },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "same" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": { "op": { "const": "contains" }, "value": { "type": ["string", "number", "boolean", "null"] } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "values"], "properties": { "op": { "const": "allowlist" }, "values": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/jsonValue" } } } },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "set_same" } } },
        { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "sequence_same" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["op"], "anyOf": [{ "required": ["maxAbsolute"] }, { "required": ["maxRelative"] }],
          "properties": { "op": { "const": "number_delta" }, "maxAbsolute": { "type": "number", "minimum": 0 }, "maxRelative": { "type": "number", "minimum": 0 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "order"],
          "properties": { "op": { "const": "rank_not_lower" }, "order": { "type": "array", "minItems": 2, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } } }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "selector", "matcher"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 5, "maxLength": 20000 },
        "severity": { "enum": ["error", "warning", "info"] },
        "selector": { "type": "string", "maxLength": 4000, "pattern": "^(|/.*)$" },
        "matcher": { "$ref": "#/$defs/matcher" },
        "limitations": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
        "tags": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assertions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "assertions": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/assertion" } }
      }
    }
  }
}
