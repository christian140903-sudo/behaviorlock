{
  "name": "behaviorlock",
  "version": "0.1.0",
  "description": "Deterministic compatibility gates for observable AI-agent behavior across model, prompt, memory, and tool changes — CLI, SDK, CI, and MCP.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "behaviorlock": "dist/src/index.js",
    "behaviorlock-mcp": "dist/src/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js serve",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:coverage": "npm run build && node --experimental-test-coverage --test dist/test/*.test.js",
    "prepack": "npm run build",
    "smoke:pack": "node scripts/release-smoke.mjs",
    "prepublishOnly": "npm run test && npm run smoke:pack"
  },
  "keywords": [
    "ai-agents",
    "behavior",
    "compatibility",
    "continuous-integration",
    "llm",
    "mcp",
    "model-context-protocol",
    "regression-testing",
    "testing",
    "tool-calls"
  ],
  "author": "Christian Bucher",
  "contributors": ["AI-assisted development under human direction and review"],
  "license": "MIT",
  "files": [
    "dist/src",
    "docs",
    "examples",
    "behaviorlock.schema.json",
    "trace.schema.json",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christian140903-sudo/behaviorlock.git"
  },
  "bugs": { "url": "https://github.com/christian140903-sudo/behaviorlock/issues" },
  "homepage": "https://nextool.app/behaviorlock/",
  "engines": { "node": ">=20.0.0" },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "mcpName": "io.github.christian140903-sudo/behaviorlock"
}
